---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SpaceBackground from "../components/SpaceBackground.astro";
import Layout from "./Layout.astro";

interface Props {
  title?: string;
  /** Background planet brightness (0..1). Lower it on reading-heavy pages. */
  bgDim?: number;
}

const { title, bgDim = 1 } = Astro.props as Props;
---

<Layout title={title}>
  <SpaceBackground />
  <Header />
  <main class="relative min-h-[75svh]" data-bg-dim={bgDim}>
    <div class="mx-auto max-w-7xl px-4 lg:px-8"><slot /></div>
  </main>
  <Footer />
</Layout>
