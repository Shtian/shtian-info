---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Prose from "../../components/Prose.astro";
import ProjectPageLayout from "../../layouts/ProjectPageLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const moonStart = Math.floor(Math.random() * 360);
---

<ProjectPageLayout title={project.data.name}>
  <header
    class="mx-auto max-w-3xl mb-12 sm:mb-16 flex flex-col sm:flex-row items-center gap-12"
  >
    <div class="relative shrink-0 size-52 sm:size-64" aria-hidden="true">
      <div
        class="absolute -inset-6 rounded-full outline-2 outline-dashed outline-foreground/10"
      ></div>
      <div
        class="absolute -inset-6 rounded-full animate-orbit"
        style={`--orbit-start: ${moonStart}deg`}
      >
        <div
          class="absolute size-5 rounded-full left-1/2 top-0 -translate-x-1/2 -translate-y-1/2 bg-radial-[at_25%_25%] from-stone-400 to-stone-700 to-75%"
        ></div>
      </div>
      <Image
        class="relative size-full rounded-full object-cover bg-neutral-900"
        src={project.data.cover}
        alt=""
        width={512}
        height={512}
        loading="eager"
        transition:name={`project-image-${project.id}`}
      />
      <div class="absolute inset-0 rounded-full planet-shade"></div>
    </div>

    <div
      class="flex flex-col gap-4 items-center text-center sm:items-start sm:text-left"
    >
      <p class="text-xs uppercase tracking-[0.2em] text-foreground/60">
        Charted {project.data.date.getFullYear()}
      </p>
      <h1
        class="text-3xl font-bold"
        transition:name={`project-title-${project.id}`}
      >
        {project.data.name}
      </h1>
      <p class="text-lg text-foreground/80">{project.data.description}</p>
      <ul class="flex gap-2 flex-wrap justify-center sm:justify-start">
        {
          project.data.tags.map((tag) => (
            <li class="border border-primary rounded-full px-2 py-1 text-xs">
              {tag}
            </li>
          ))
        }
      </ul>
      <a
        href={project.data.link}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-2 inline-flex items-center gap-2 rounded-full border border-foreground/20 px-4 py-2 text-sm text-foreground/80 hover:text-foreground hover:border-primary transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
        Source on GitHub
      </a>
    </div>
  </header>

  <Prose>
    <Content />
  </Prose>
</ProjectPageLayout>

<style>
/* Light from the upper right, matching the background scene. */
.planet-shade {
  background: radial-gradient(
    circle at 72% 28%,
    transparent 30%,
    oklch(var(--background) / 0.35) 62%,
    oklch(var(--background) / 0.85) 100%
  );
  box-shadow:
    inset -10px 10px 18px -8px oklch(92% 0.03 230 / 0.35),
    0 0 60px oklch(85% 0.04 230 / 0.08);
}

@keyframes orbit {
  from {
    transform: rotate(var(--orbit-start, 0deg));
  }
  to {
    transform: rotate(calc(var(--orbit-start, 0deg) + 360deg));
  }
}

.animate-orbit {
  animation: orbit 24s linear infinite;
}

@media (prefers-reduced-motion: reduce) {
  .animate-orbit {
    animation: none;
    transform: rotate(var(--orbit-start, 0deg));
  }
}
</style>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.data.name,
    description: project.data.description,
    author: {
      "@type": "Person",
      name: "Stian Haga",
      url: "https://www.shtian.info",
    },
    datePublished: project.data.date.toISOString(),
    image: project.data.cover,
    url: project.data.link,
  })}
/>
